# TABULA RASA — environment template.
# Copy to .env.local for local development. NEVER commit real values.
# The public game needs none of these: with everything unset the app runs fully offline.

# ── Live mode master switch (default: off). Live mode also needs every value below.
LIVE_ENABLED=false

# ── Anthropic (server only; never prefix with NEXT_PUBLIC_)
ANTHROPIC_API_KEY=
# Exact model id for runtime cognition. No default: unset means live mode is unavailable.
ANTHROPIC_MODEL=

# ── Durable database for the budget ledger and live-run state (server only).
# Production requires PostgreSQL. Leave unset locally to use an on-disk PGlite database in .data/.
DATABASE_URL=
# Optional: a schema name, to keep these tables apart inside a shared database.
DATABASE_SCHEMA=

# ── Owner authentication (server only)
# Generate both with: pnpm owner:hash   (asks for a passphrase, prints the two lines to paste here)
OWNER_PASSWORD_HASH=
# Random secret (32+ characters) that signs owner sessions. Changing it signs everyone out.
AUTH_SECRET=

# ── Optional: the date (YYYY-MM-DD) on which you re-checked the provider's published prices against
# the table in src/providers/prices.ts. Live mode refuses to run on a price table older than its limit.
PRICES_ATTESTED_ON=

# ── Optional: real-concurrency ledger tests against a PostgreSQL server
TEST_DATABASE_URL=
