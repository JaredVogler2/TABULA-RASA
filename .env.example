# TABULA RASA — environment template.
# Copy to .env.local for local development. NEVER commit real values.
# The public game needs none of these: with everything unset the app runs fully offline.

# ── Live mode master switch (default: off). Live mode also needs every value below.
LIVE_ENABLED=false

# ── Anthropic (server only; never prefix with NEXT_PUBLIC_)
ANTHROPIC_API_KEY=
# Exact model id for runtime cognition. No default: unset means live mode is unavailable.
ANTHROPIC_MODEL=

# ── The most this deployment may EVER be authorized to spend, in dollars (e.g. 25 or 7.50; at most 10000).
# The owner console cannot raise it and cannot authorize past it: it is changed here, where the
# application is deployed, by whoever controls the deployment. Unset or 0 means nothing can be
# authorized and live mode is unavailable.
BUDGET_CEILING_USD=

# ── Durable database for the budget ledger and live-run state (server only).
# Live mode requires PostgreSQL everywhere. Leave unset locally to try the owner console and mock
# runs on an on-disk PGlite database in .data/ (never used for paid calls).
DATABASE_URL=
# Optional: a schema name, to keep these tables apart inside a shared database.
DATABASE_SCHEMA=

# ── Owner authentication (server only)
# Generate both with: pnpm owner:hash   (asks for a passphrase, prints the two lines to paste here)
OWNER_PASSWORD_HASH=
# Random secret (32+ characters) that signs owner sessions. Changing it signs everyone out.
AUTH_SECRET=

# ── Optional: the date (YYYY-MM-DD) on which you re-checked the provider's published prices against
# the table in src/providers/prices.ts. Live mode refuses to run on a price table older than its limit.
PRICES_ATTESTED_ON=

# ── Optional, and only off Vercel: set to true if a proxy you control overwrites X-Forwarded-For.
# Without it (and off Vercel) the header is not believed and every client shares one rate-limit bucket.
TRUST_FORWARDED_FOR=

# ── Do NOT set any of these: the application ignores them, and live mode stays off while one is set.
# ANTHROPIC_BASE_URL  ANTHROPIC_AUTH_TOKEN  ANTHROPIC_CUSTOM_HEADERS  ANTHROPIC_LOG
# ANTHROPIC_OPEN_TELEMETRY_TRACES_CONTENT_MODE

# ── The live smoke test (pnpm live:smoke) takes its two variables on the command line, never from a file:
#   LIVE_SMOKE_MAX_USD=2 LIVE_SMOKE_CONFIRM="I authorize live smoke test <n> for at most $2" pnpm live:smoke -- --run
# Run `pnpm live:smoke` first: it says what is missing and prints the exact words for the next run.

# ── Optional: real-concurrency ledger tests against a PostgreSQL server
TEST_DATABASE_URL=
